# Скопируй в .env и заполни. harness подхватывает .env автоматически.
# Полная таблица переменных — в GUIDE.md §9.

# ── Cursor ────────────────────────────────────────────────────────────────────
# Ключ для SDK-ролей (оркестратор/ревьюер). Воркеры на CLI работают по подписке.
CURSOR_API_KEY=
# Доп. флаги cursor-agent (опционально)
# CURSOR_FLAGS=

# ── Модели (китайские; оркестратор остаётся Opus) ─────────────────────────────
ORCH_MODEL=opus-4.8
WORKER_MODEL=auto
REVIEWER_MODEL=glm-5.2-high
ESCALATION_MODELS=kimi-k2.5,glm-5.2-high
ESCALATE_AFTER=2
# MAX_ATTEMPTS=4            # по умолчанию адаптивный (escalate_after + число ступеней)
MAX_REPLANS=1
MAX_PARALLEL=3

# ── Экономика / безопасность ──────────────────────────────────────────────────
# RUN_BUDGET=50            # потолок расходов на Run (жёсткий стоп)
PROTECTED_PATHS=tests/spec/**
HARNESS_SANDBOX=local      # local | docker
HUMAN_GATE_MERGE=0         # 1 = пауза + аппрув перед мержем в base

# ── Telegram (нотификации + бот) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Durable-режим (опционально, нужен Postgres: make pg-up) ───────────────────
HARNESS_DURABLE=0
DBOS_SYSTEM_DATABASE_URL=postgresql://harness:harness@localhost:5439/harness
