# Скопируй в .env и заполни. harness подхватывает .env автоматически.
# Полная таблица — GUIDE.md § env. Primary path: TaskTool pull mode.

# ── Cursor (legacy SDK/CLI runners only) ──────────────────────────────────────
# Нужен для `harness plan`/`harness run` на SdkRunner. TaskTool-first path
# вызывает модели через Cursor Task Tool в IDE — этот ключ там не обязателен.
CURSOR_API_KEY=
# CURSOR_FLAGS=

# ── TaskTool-first model routing (Grok-first; см. docs/GROK-DEFAULTS.md) ──────
# orch / worker / reviewer / research → Grok 4.5 High by default
# Overrides: TASKTOOL_*_MODEL only (exact Cursor Task Tool slugs).
# Legacy ORCH_MODEL / WORKER_MODEL / REVIEWER_MODEL are ignored by TaskTool routing.
TASKTOOL_ORCH_MODEL=cursor-grok-4.5-high
TASKTOOL_WORKER_MODEL=cursor-grok-4.5-high
TASKTOOL_REVIEWER_MODEL=cursor-grok-4.5-high
# Роли раннеров для TaskTool path не используются (Python не вызывает агентов).
# Оставь sdk/cli только если сознательно гоняешь legacy push Engine.
# ORCH_RUNNER=sdk
# WORKER_RUNNER=sdk
# REVIEWER_RUNNER=sdk

# ── Legacy SDK/CLI defaults (отдельный мир; не смешивай без нужды) ─────────────
# ORCH_MODEL=claude-opus-4-8
# WORKER_MODEL=kimi-k2.5
# REVIEWER_MODEL=glm-5.2
# ESCALATION_MODELS=kimi-k2.5,glm-5.2-high
# ESCALATE_AFTER=2
# MAX_ATTEMPTS=                       # без явного: escalate_after + ступени лестницы
# MAX_REPLANS=1
# MAX_PARALLEL=6

# ── TaskTool resource admission (this host: 24 CPU / 125 GiB) ─────────────────
# Code hard-ceiling = 16 Task Tool jobs; default wave = 12 (env can go 1..16).
MAX_TASKTOOL_JOBS=12         # or HARNESS_MAX_TASKTOOL_JOBS
MAX_AGENT_SLOTS=12
MAX_HEAVY_JOBS=5
MAX_GATES=4
# Пороги по умолчанию считаются от ёмкости машины (cgroup-лимит, иначе MemTotal):
# soft = 1/8, hard = 1/16 — на этом хосте это ≈16 и ≈8 GiB. Раскомментируй,
# только если нужно зафиксировать абсолютные значения.
# SOFT_MEM_AVAILABLE_BYTES=17179869184   # 16 GiB MemAvailable → throttle
# HARD_MEM_AVAILABLE_BYTES=8589934592    # 8 GiB MemAvailable → pause
LOAD_PER_CPU_THRESHOLD=1.1             # throttle at load1 >= cpu_count * 1.1
HARNESS_DECOMPOSE_MAX_CHILDREN=12
# Dispatch lease TTL. Task Tool jobs cannot heartbeat, so `next` renews the
# leases the calling agent still holds; this only has to outlive the gap between
# two `next` calls plus the slowest job. Too short ⇒ live work is reclaimed and
# a second agent gets the same files_owned.
HARNESS_DISPATCH_LEASE_MINUTES=60
# Speed: review only large|high; unlock DAG after parent gates (not after reviewer)
HARNESS_REVIEW_MIN_COMPLEXITY=large
HARNESS_DAG_UNLOCK=post_gate
# Legacy (ADR-0012 era): 8 jobs / ceiling 12 / load 0.75
# Legacy small-VPS reference (8 CPU / 16 GiB era): 4 jobs / soft 3 GiB / hard 2 GiB / load 1.0

# Isolation / ship (V4 defaults: worktrees ON, manual ship, soft gates OFF)
HARNESS_USE_WORKTREES=1      # required for multi-active; 0 = legacy in-place (1.harness)
HARNESS_SHIP_MODE=manual     # manual | merge (--approved-merge path)
HARNESS_MULTI_TENANT=1       # default ON; ~4 tenants OK with worktrees + run roots
HARNESS_ALLOW_SOFT_GATES=0   # 1 = escape hatch for optional sensors (non-prod)
HARNESS_CONTEXT_POINTER_ONLY=1  # ContextPack: pointers not dumps (Phase 0.5+)
HARNESS_USE_RUN_ROOTS=1         # 1 = .harness/runs/<id>/ SoT (default); plan does not overwrite shared PLAN.md
HARNESS_RUN_ROOT=.harness/runs  # per-run SoT (Phase 1); shared PLAN is staging only when run-roots ON
HARNESS_EVIDENCE_GATE=1         # 1 = DONE requires attested evidence (v4 default ON; set 0 only as emergency)
HARNESS_EVIDENCE_CLI_MINT=0     # 1 = allow harness evidence add --exit-code 0 for gates (operator only)
HARNESS_EVIDENCE_EXCLUSIVE_BIND=1  # 1 = 1:1 AC↔evidence; refuse mass-flip reuse (default ON)
HARNESS_REQUIRE_DECLARED_BINDING=1 # 1 = evidence.acceptance_item_ids must list the AC being flipped
HARNESS_REQUIRE_NESTED_WORKERS=1   # 1 = flag cosplay_risk when one agent reports all medium+ workers
HARNESS_NESTED_WORKERS_HARD_FAIL=1 # 1 = refuse DONE on cosplay_risk (v4 default ON; set 0 for warn-only emergency)
# HARNESS_ALLOW_EVIDENCE_REUSE=0     # 1 = escape hatch for shared evidence across ACs
# HARNESS_ALLOW_MASS_FLIP=0          # 1 = allow one evidence blob to flip many ACs (debug only)
# Optional: HARNESS_EVIDENCE_SECRET=...  # else key file under $HARNESS_HOME/.harness/secrets/evidence.hmac

# Phase 2 governors (solo-safe defaults: aggressive OFF)
HARNESS_PRECALL_BUDGET=0        # 1 = enforce max_steps / wall / tokens in next/advance
# HARNESS_MAX_STEPS=200
# HARNESS_MAX_WALL_CLOCK_SEC=14400   # 4h dogfood
# HARNESS_MAX_TOKENS_EST=
HARNESS_LOOP_DETECT=1           # tool-hash stall → phase stuck (default on)
HARNESS_TOOL_HASH_REPEAT=3
HARNESS_SPRINT_CONTRACT=0       # 1 = medium/large freeze AC before coding
HARNESS_OBSERVATION_MASK_CHARS=2400
# Phase 3 economics (solo-safe: OFF by default)
HARNESS_ECONOMICS=0             # 1 = breadth gate + fan-out profile caps
HARNESS_FANOUT_PROFILE=solo     # solo (4 jobs / 4 children) | team (12 / 12)
# Phase 4 meta / AHE-lite (CLI always works; flag = dogfood habit opt-in)
HARNESS_META=0                  # 1 = remind orch to changelog+eval harness edits
# HARNESS_TENANT_ID=           # default $USER
# Discoverability: point installs at this clone (alias of HARNESS_ROOT)
# HARNESS_HOME=/home/1.harness-v4
# HARNESS_ROOT=/home/1.harness-v4

# ── Экономика / безопасность ──────────────────────────────────────────────────
# RUN_BUDGET=50
PROTECTED_PATHS=tests/spec/**
HARNESS_SANDBOX=local      # local | docker
HUMAN_GATE_MERGE=0         # 1 = пауза + аппрув перед мержем в base
HARNESS_PUSH_AFTER_MERGE=0
# HARNESS_GIT_REMOTE=origin
# HARNESS_DESLOPPIFY=0     # legacy Engine only; TaskTool path has no default de-sloppify agent

# ── Telegram (нотификации + бот; опционально) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Legacy chat bridge / durable (compatibility — не default TaskTool path) ───
# HARNESS_RUNNER=cursor_task          # harness mode chat (deprecated bridge)
# HARNESS_CHAT_BRIDGE=                # default <root>/.harness/bridge
# HARNESS_CHAT_BRIDGE_TIMEOUT=1800
# HARNESS_CHAT_BRIDGE_POLL=2
# HARNESS_DURABLE=0                   # DBOS background — see BACKLOG-background-mode.md
# DBOS_SYSTEM_DATABASE_URL=postgresql://harness:harness@localhost:5439/harness
# ── Brain / знания (lessons, ADR, architecture notes) ────────────────────────
# V4 Phase 3: agent layer (writable) vs human canon (read-only sync source)
HARNESS_BRAIN_ROOT=/home/brain-agents
HARNESS_BRAIN_CANON=/home/brain
# Agent-in-agent: large-задачи декомпозируются sub-orchestrator'ом (1 = on)
HARNESS_DECOMPOSE=1
# ── Пер-проектный журнал работ (ADR-0013): решения/сделано/итерации → в репо ──
HARNESS_PROJECT_JOURNAL=1
HARNESS_JOURNAL_DIR=docs/history

# ── Остальные переменные, читаемые кодом ─────────────────────────────────────
# Раньше их не было здесь: код читал 70 переменных, описано было 47. Значения
# ниже — дефолты из кода; строки закомментированы, раскомментируй при отличии.

# Пути / идентичность
# HARNESS_ROOT=                       # корень harness; HARNESS_HOME — его алиас
# HARNESS_HOME=
# HARNESS_TENANT_ID=                  # default: $USER

# Бюджеты и предохранители прогона (harness/config.py)
# HARNESS_MAX_STEPS=200               # pre-call governor: шагов на run
# HARNESS_MAX_WALL_CLOCK_SEC=         # pre-call governor: стена по времени
# HARNESS_MAX_TOKENS_EST=             # pre-call governor: оценка токенов
# HARNESS_DISPATCH_LEASE_MINUTES=60   # см. секцию admission выше

# Контекст, отдаваемый агентам
# HARNESS_CONTEXT_CHAR_BUDGET=9000    # бюджет ContextPack
# HARNESS_REVIEW_DIFF_BYTES=          # потолок диффа в ревью-бандле
# HARNESS_MAX_DIFF_BYTES=             # потолок диффа воркера
# HARNESS_MAX_COMMIT_BYTES=           # потолок коммита в worktree

# Честность / доказательства (см. docs/HONESTY-MODE.md)
# HARNESS_EVIDENCE_SECRET=            # HMAC-ключ; иначе файл под $HARNESS_HOME
# HARNESS_EVIDENCE_CLI_MINT=0         # 1 = разрешить `evidence add` зелёные строки
# HARNESS_ALLOW_EVIDENCE_REUSE=0      # 1 = одно доказательство на несколько AC
# HARNESS_ALLOW_MASS_FLIP=0           # 1 = массовый flip acceptance-пунктов

# Git / мерж
# HARNESS_GIT_REMOTE=origin

# Legacy push Engine (не TaskTool-путь)
# HARNESS_PREFLIGHT=1
# HARNESS_DESLOPPIFY=0
# HARNESS_DESLOPPIFY_MODEL=
# HARNESS_COMPLETION_THRESHOLD=
# HARNESS_COMPACT_THRESHOLD=
# HARNESS_CONTEXT_LOW_THRESHOLD=
# HARNESS_KEEP_PROMPTS=0              # 1 = не удалять временные промпты CLI-раннера
# HARNESS_PROMPT_VIA_SHELL=0

# Только для чтения кодом, задавать не нужно:
#   TASKTOOL_PROTOCOL_VERSION — константа протокола (harness/tasktool/__init__.py)
#   HARNESS_DONE — токен завершения в тексте воркера, не переменная окружения
